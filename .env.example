# Copy to .env and fill local secrets. Never commit .env.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://127.0.0.1:8000/oauth/strava/callback
STRAVA_WEBHOOK_CALLBACK_URL=
# Public tunnels are disabled by default. Set true only after a separate security review.
HEALTH_ENABLE_NGROK=false
STRAVA_WEBHOOK_VERIFY_TOKEN=
APP_SECRET=replace-with-a-long-random-value
DATABASE_PATH=data/health.db
MI_FITNESS_AUTH_PATH=data/.mijia/auth.json
MI_FITNESS_SYNC_DAYS=14
MOBILE_ACCESS_PASSWORD=
# LAN access token for phone browsers (service binds 0.0.0.0). Leave blank to
# auto-generate one persisted at data/lan_token.txt (gitignored).
HEALTH_LAN_TOKEN=
MEAL_LLM_API_KEY=
# 图片分析接口（任何 OpenAI Responses 协议兼容端点均可），按需自行配置
MEAL_LLM_BASE_URL=
MEAL_LLM_MODEL=
